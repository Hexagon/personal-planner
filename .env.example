AUTH_SECRET=replace-with-at-least-32-random-bytes
# Configure one or both provider pairs; an incomplete pair is an error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional shared key; users can instead enter a key for their current browser tab.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
APP_ORIGIN=http://localhost:8000
# Opt in to public indexing only on the production HTTPS deployment.
APP_ENV=development
PORT=8000
