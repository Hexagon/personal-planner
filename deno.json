{
  "tasks": {
    "start": "deno run --unstable-kv --env-file=.env --allow-env --allow-net --allow-read=public,data --allow-write=data src/main.ts",
    "dev": "deno run --unstable-kv --env-file=.env --allow-env --allow-net --allow-read=public,data --allow-write=data --watch=src,public src/main.ts",
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test --unstable-kv",
    "check": "deno task fmt && deno task lint && deno check --unstable-kv src/main.ts public/app.js && deno check --unstable-kv --unstable-cron src/deploy.ts && deno task test"
  },
  "imports": {
    "@auth/core": "npm:@auth/core@0.41.3",
    "croner": "npm:croner@10.0.1"
  }
}
